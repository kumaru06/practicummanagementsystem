// Copy to database.production.php on Hostinger (public_html/config/database.production.php).
// hPanel → Databases → Management → use the exact MySQL database name and user shown there.
// PHP on Hostinger uses host "localhost".
define('_DB_HOST', 'localhost');
define('_DB_NAME', 'your_database_name');
define('_DB_USER', 'your_database_user');
define('_DB_PASS', 'your_mysql_password_from_hpanel');
