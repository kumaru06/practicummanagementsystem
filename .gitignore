# Secrets — keep only on this PC or on the server. Never commit real passwords.
.env
.env.*
!.env.example
config/database.production.php
config/mail.local.php
config/mail.local.dev.php
config/*.local.php
hostinger.deploy.json
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub

# User uploads (keep folder structure via .gitkeep)
uploads/*
!uploads/.htaccess
!uploads/**/.gitkeep
!uploads/DO_NOT_DELETE.txt

# Database exports and backups. Schema and migrations stay in git.
database/hostinger_export.sql
database/*.dump.sql
database/*export*.sql
database/*backup*.sql
*.sql.gz

# Deployment artifacts (regenerated by deploy scripts)
*.zip
amaccmanagementsystem_deploy.zip
hostinger-deploy*.zip

# Debug / temp
debug-*.log
uploads/debug-*.log
_zip_test/

# k6 live capacity run outputs
tools/k6/results/

# OS & IDE
Thumbs.db
.Desktop.ini
.idea/
.vscode/
*.swp
.cursor/debug-*.log


toast-v2-preview.html

# Local FTP helpers. The password stays in hostinger.deploy.json, which is already ignored.
# These stay on this PC only so a commit cannot publish the FTP login again.
tools/ftp-deploy.ps1
tools/ftp-probe.ps1