# Copy to .env and fill in real values. Never commit .env to git.

# --- Database (production / Hostinger only — Laragon uses practicum_system / root) ---
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_mysql_password

# --- Hostinger email (SMTP) ---
# Use ONE active mailbox. If suspended, create a new one in hPanel → Emails.
# SMTP_USERNAME and MAIL_FROM_EMAIL must match the same mailbox address.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=your-mailbox@ama-ojtportal.com
SMTP_PASSWORD=your_email_password
MAIL_FROM_EMAIL=your-mailbox@ama-ojtportal.com
MAIL_FROM_NAME=AMA Education System - College Department

# Student registration verification (optional separate mailbox)
REGISTRATION_SMTP_USERNAME=register@ama-ojtportal.com
REGISTRATION_SMTP_PASSWORD=your_registration_mailbox_password
REGISTRATION_MAIL_FROM_EMAIL=register@ama-ojtportal.com
REGISTRATION_MAIL_FROM_NAME=AMA OJT Student Registration

# Temporary testing bypasses
# TEMPORARY_REPORT_UNLOCK — local/dev only (ignored on live). Unlocks DTR/weekly gates.
TEMPORARY_REPORT_UNLOCK=false
# TEMPORARY_ORIENTATION_PAST_DATES — allow past orientation / official OJT start dates.
# Works on live when true. Set back to false after testing so normal rules apply.
TEMPORARY_ORIENTATION_PAST_DATES=false
